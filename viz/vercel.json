{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/", "destination": "/app.html?city=asheville", "permanent": false },
    { "source": "/index.html", "destination": "/app.html?city=asheville", "permanent": false },
    { "source": "/cities", "destination": "/app.html?city=asheville", "permanent": false },
    { "source": "/cities.html", "destination": "/app.html?city=asheville", "permanent": false },
    { "source": "/contribute", "destination": "/app.html?city=asheville", "permanent": false },
    { "source": "/contribute.html", "destination": "/app.html?city=asheville", "permanent": false },
    { "source": "/login", "destination": "/app.html?city=asheville", "permanent": true },
    { "source": "/login.html", "destination": "/app.html?city=asheville", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/api/data/:path*",
      "destination": "https://addfrq9d2diumsge.public.blob.vercel-storage.com/:path*"
    },
    { "source": "/app", "destination": "/app.html" },
    { "source": "/parking", "destination": "/parking.html" },
    { "source": "/review", "destination": "/review.html" },
    { "source": "/cle-logo.svg", "destination": "/CLE-Logo.svg" },
    { "source": "/CLE-logo.svg", "destination": "/CLE-Logo.svg" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
